rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(parentId) {
      return isAuth() && request.auth.uid == parentId;
    }
    function isOwnerResource() {
      return isAuth() && resource != null && resource.data.parent_id == request.auth.uid;
    }
    function entitlementDoc(parentId) {
      return exists(/databases/$(database)/documents/accountEntitlements/$(parentId))
        ? get(/databases/$(database)/documents/accountEntitlements/$(parentId)).data
        : null;
    }
    function entitlementPlanId(parentId) {
      let entitlement = entitlementDoc(parentId);
      return entitlement != null && entitlement.plan_id is string
        ? entitlement.plan_id
        : "free";
    }
    function hasLockdownEntitlement(parentId) {
      let entitlement = entitlementDoc(parentId);
      return entitlementPlanId(parentId) == "lockdown" ||
        (
          entitlement != null &&
          entitlement.feature_overrides is map &&
          (
            entitlement.feature_overrides.can_use_lockdown_extension == true ||
            entitlement.feature_overrides.can_use_lockdown_kiosk == true
          )
        );
    }
    function studentExists(studentId) {
      return exists(/databases/$(database)/documents/students/$(studentId));
    }
    function subjectExists(subjectId) {
      return exists(/databases/$(database)/documents/subjects/$(subjectId));
    }
    function timerSubjectIsAssigned(studentId, subjectId) {
      let subject = subjectExists(subjectId)
        ? get(/databases/$(database)/documents/subjects/$(subjectId)).data
        : null;
      return subject != null && (
        (subject.student_ids is list && studentId in subject.student_ids) ||
        subject.student_id == studentId
      );
    }
    function validTimerTimerSessionData(data) {
      return data.student_id is string &&
        data.subject_id is string &&
        data.parent_id is string &&
        data.block_index is int &&
        data.start_time is int &&
        data.duration_ms is int &&
        data.duration_minutes is int &&
        data.target_end_time is int &&
        data.initial_duration_ms is int &&
        data.remaining_time is int &&
        data.is_running is bool &&
        data.saved_at is int;
    }
    function studentOwnedByParent(studentId, parentId) {
      return studentExists(studentId) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.parent_id == parentId;
    }
    function weeklyPlanDocId(parentId, studentId, weekKey) {
      return parentId + "_" + studentId + "_" + weekKey;
    }
    function isOwnerWeeklyPlanLookup(weeklyPlanId) {
      return isAuth() && weeklyPlanId.matches("^" + request.auth.uid + "_.+");
    }
    function validWeeklyPlanStatus(status) {
      return status == "draft" ||
        status == "published" ||
        status == "archived";
    }
    function validWeeklyPlanData(data, weeklyPlanId, parentId) {
      return data.parent_id is string &&
        data.student_id is string &&
        data.week_key is string &&
        data.assignment_ids is list &&
        data.weekly_exceptions is list &&
        data.blocks is list &&
        data.week_start != null &&
        data.week_end != null &&
        data.status is string &&
        validWeeklyPlanStatus(data.status) &&
        data.parent_id == parentId &&
        weeklyPlanId == weeklyPlanDocId(data.parent_id, data.student_id, data.week_key) &&
        studentOwnedByParent(data.student_id, data.parent_id);
    }
    function isPublishedPortalWeeklyPlan(data, weeklyPlanId) {
      return data != null &&
        data.status == "published" &&
        validWeeklyPlanData(data, weeklyPlanId, data.parent_id);
    }

    // Students: portal resolves student records by slug, which requires query/list access
    match /students/{studentId} {
      allow read: if true;
      allow create: if false;
      allow update: if isOwner(resource.data.parent_id) &&
        request.resource.data.parent_id == resource.data.parent_id &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["weekly_planning_version", "weekly_planning_adopted_at", "school_authority_version", "school_state_revision", "school_authority_adopted_at"]);
      allow delete: if isOwner(resource.data.parent_id);
    }

    // Subjects: parents own their records; students need read access for the portal
    function isQuotaActiveSubject(data) {
      return data.get("is_active", true) != false &&
        data.get("is_archived", false) != true && data.get("archived", false) != true &&
        data.get("status", "") != "archived" && data.get("archived_at", null) == null;
    }
    match /subjects/{subjectId} {
      allow read: if true;
      allow create: if false;
      allow update: if isOwner(resource.data.parent_id) &&
        request.resource.data.parent_id == resource.data.parent_id &&
        (isQuotaActiveSubject(resource.data) || !isQuotaActiveSubject(request.resource.data));
      allow delete: if isOwner(resource.data.parent_id);
    }

    // Private transaction coordinator, never a client-maintained quota counter.
    match /quotaMutationState/{document=**} { allow read, write: if false; }

    function usesTrustedSchoolAuthority(studentId) {
      return studentExists(studentId) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.get("school_authority_version", 0) >= 1;
    }
    function hasSchoolAuthorityFields(data) {
      return data.keys().hasAny(["authority_version", "actor_id", "weekly_plan_id", "weekly_block_id", "trusted_elapsed_ms", "timer_session_id",
        "session_id", "context_signature", "state_revision", "duration_ms", "elapsed_ms", "started_at_ms", "target_end_ms"]);
    }
    // Legacy compatibility remains until per-student authority is adopted.
    // Activated evidence is immutable; all completion/correction writes are trusted.
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if !usesTrustedSchoolAuthority(request.resource.data.student_id) &&
        studentOwnedByParent(request.resource.data.student_id, request.resource.data.parent_id) &&
        timerSubjectIsAssigned(request.resource.data.student_id, request.resource.data.subject_id) &&
        !hasSchoolAuthorityFields(request.resource.data);
      allow update: if isOwnerResource() && !usesTrustedSchoolAuthority(resource.data.student_id) &&
        !hasSchoolAuthorityFields(resource.data) && !hasSchoolAuthorityFields(request.resource.data) &&
        request.resource.data.parent_id == resource.data.parent_id &&
        request.resource.data.student_id == resource.data.student_id;
      allow delete: if isOwnerResource() && !usesTrustedSchoolAuthority(resource.data.student_id) && !hasSchoolAuthorityFields(resource.data);
    }

    function hasTrustedTimerFields(data) {
      return data.keys().hasAny(["authority_version", "session_id", "context_signature", "state_revision", "elapsed_ms", "started_at_ms", "target_end_ms"]);
    }
    match /timerSessions/{timerSessionId} {
      allow get: if resource == null || isOwnerResource() ||
        (!usesTrustedSchoolAuthority(resource.data.student_id) && !hasTrustedTimerFields(resource.data) &&
          timerSubjectIsAssigned(resource.data.student_id, resource.data.subject_id));
      allow list: if isOwnerResource();
      allow create: if !usesTrustedSchoolAuthority(request.resource.data.student_id) &&
        !hasTrustedTimerFields(request.resource.data) &&
        timerSubjectIsAssigned(request.resource.data.student_id, request.resource.data.subject_id) &&
        validTimerTimerSessionData(request.resource.data);
      allow update: if !usesTrustedSchoolAuthority(request.resource.data.student_id) &&
        !usesTrustedSchoolAuthority(resource.data.student_id) && !hasTrustedTimerFields(resource.data) &&
        !hasTrustedTimerFields(request.resource.data) &&
        request.resource.data.student_id == resource.data.student_id &&
        timerSubjectIsAssigned(request.resource.data.student_id, request.resource.data.subject_id) &&
        validTimerTimerSessionData(request.resource.data);
      allow delete: if resource == null || (!usesTrustedSchoolAuthority(resource.data.student_id) &&
        !hasTrustedTimerFields(resource.data) && timerSubjectIsAssigned(resource.data.student_id, resource.data.subject_id));
    }

    function allowsLegacyWeeklyPlanWrite(data) {
      return !data.keys().hasAny(["schema_version"]) &&
        get(/databases/$(database)/documents/students/$(data.student_id)).data.get("weekly_planning_version", 0) < 1 &&
        !usesTrustedSchoolAuthority(data.student_id);
    }

    // Versioned weekly plans are written atomically by trusted planning callables.
    match /weeklyPlans/{weeklyPlanId} {
      allow get: if isOwnerWeeklyPlanLookup(weeklyPlanId) ||
        (
          resource != null &&
          (
            isOwner(resource.data.parent_id) ||
            isPublishedPortalWeeklyPlan(resource.data, weeklyPlanId)
          )
        );
      allow list: if isOwnerResource();
      allow delete: if false;
      allow create: if isAuth() &&
        validWeeklyPlanData(request.resource.data, weeklyPlanId, request.auth.uid) &&
        allowsLegacyWeeklyPlanWrite(request.resource.data);
      allow update: if isOwner(resource.data.parent_id) &&
        validWeeklyPlanData(request.resource.data, weeklyPlanId, resource.data.parent_id) &&
        request.resource.data.parent_id == resource.data.parent_id &&
        request.resource.data.student_id == resource.data.student_id &&
        request.resource.data.week_key == resource.data.week_key &&
        allowsLegacyWeeklyPlanWrite(resource.data) && allowsLegacyWeeklyPlanWrite(request.resource.data);
    }

    // Private planning records have server-owned revisions and identity history.
    match /weeklyPlanDrafts/{weeklyPlanId} {
      allow get: if (resource == null && isOwnerWeeklyPlanLookup(weeklyPlanId)) || isOwnerResource();
      allow list: if isOwnerResource();
      allow write: if false;
    }
    match /studentDefaultWeeks/{defaultWeekId} {
      allow get: if (resource == null && isOwnerWeeklyPlanLookup(defaultWeekId)) || isOwnerResource();
      allow list: if isOwnerResource();
      allow write: if false;
    }
    match /weeklyPlanningReceipts/{recordId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    match /schoolPublicationBridges/{recordId} { allow read: if isOwnerResource(); allow write: if false; }
    match /schoolExecutionSnapshots/{recordId} { allow read: if isOwnerResource(); allow write: if false; }
    match /schoolOperationReceipts/{recordId} { allow read: if isOwnerResource(); allow write: if false; }
    match /schoolStateHistory/{recordId} { allow read: if isOwnerResource(); allow write: if false; }
    match /schoolReportAmendmentHeads/{recordId} { allow read: if isOwnerResource(); allow write: if false; }

    // Authority and sensitive history are server-written, parent-readable only.
    // A later trusted student callable returns a safe projection, not these docs.
    match /blockCompletionStates/{recordId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }
    match /parentCorrectionEvents/{recordId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }
    match /weeklyReportAmendments/{recordId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }
    match /routineDaySnapshots/{recordId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }
    match /routineDayPointers/{recordId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }
    match /productDirectionConfig/{id} {
      allow read, write: if false;
    }

    match /productDirectionMigrations/{recordId} {
      allow read, write: if false;
    }
    match /householdHistoryEvents/{recordId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }
    match /studentCosmeticStates/{recordId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    // Weekly reports: parent-scoped only
    match /weeklyReports/{reportId} {
      allow read: if isOwnerResource();
      allow create: if false; // Official originals are filed atomically by the trusted school adapter.
      allow update: if false; // Original saved snapshots never change; corrections append amendments.
      allow delete: if isOwnerResource() && !exists(/databases/$(database)/documents/schoolReportAmendmentHeads/$(reportId));
    }

    // Parent profiles: owner only
    match /parents/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // Account entitlements: server-owned billing and plan state
    match /accountEntitlements/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Entitlement audit logs: server-owned support and billing history
    match /entitlementAuditLogs/{logId} {
      allow read, write: if false;
    }

    // Support operators: server-owned allowlist for trusted operator callables
    match /supportOperators/{userId} {
      allow read, write: if false;
    }

    // Lockdown PoC policies: legacy compatibility path only until Phase 4 migrates
    // the extension runtime to the trusted device-policy contract.
    match /lockdownPolicies/{policyId} {
      allow get: if true;
      allow list, delete: if isAuth() && request.auth.uid == policyId;
      allow create: if isAuth() &&
        request.auth.uid == policyId &&
        request.resource.data.parent_id == request.auth.uid &&
        hasLockdownEntitlement(request.auth.uid);
      allow update: if isAuth() &&
        request.auth.uid == policyId &&
        resource.data.parent_id == request.auth.uid &&
        request.resource.data.parent_id == request.auth.uid &&
        hasLockdownEntitlement(request.auth.uid);
    }

    // Trusted lockdown pairing tickets and device credentials are server-owned only.
    match /lockdownEnrollmentSessions/{sessionId} {
      allow read, write: if false;
    }

    match /lockdownRecoverySessions/{sessionId} {
      allow read, write: if false;
    }

    match /lockdownDevices/{deviceId} {
      allow read, write: if false;
    }

    match /lockdownResourceLibrary/{resourceId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    // Chores, routines, allowance, points, and rewards are served through
    // trusted callables so public student portal reads cannot enumerate a
    // household's private chore/reward state.
    match /choreSettings/{parentId} {
      allow read: if isOwner(parentId);
      allow write: if false;
    }

    match /rewardSettings/{parentId} {
      allow read: if isOwner(parentId);
      allow write: if false;
    }

    match /routineTemplates/{routineTemplateId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    match /routineCompletions/{routineCompletionId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    match /choreDefinitions/{choreDefinitionId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    match /choreClaims/{choreClaimId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    match /choreCompletions/{choreCompletionId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    match /allowancePeriods/{allowancePeriodId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    match /pointLedgerEntries/{pointLedgerEntryId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    match /studentPointWallets/{studentPointWalletId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    match /rewardCatalogItems/{rewardCatalogItemId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    match /rewardRedemptions/{rewardRedemptionId} {
      allow read: if isOwnerResource();
      allow write: if false;
    }

    // Daily logs remain parent-authenticated until a narrower trusted path exists.
    match /dailyLogs/{logId} {
      allow read, write: if isAuth();
    }

    // Billing provider bindings, immutable intents/attempts and webhook receipts
    // are private server authority; even the owner uses a minimal callable view.
    match /billingAccounts/{document=**} { allow read, write: if false; }
    match /billingCheckoutIntents/{document=**} { allow read, write: if false; }
    match /billingCheckoutAttempts/{document=**} { allow read, write: if false; }
    match /billingEventReceipts/{document=**} { allow read, write: if false; }

    // Deny everything else by default so specific collection matches stay authoritative.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
