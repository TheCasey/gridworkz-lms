{
  "name": "gridworkz-lms",
  "version": "1.0.0",
  "description": "A high-autonomy, block-based learning management system for homeschool families",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "check:student-timers": "node scripts/check-student-timer-sessions.mjs",
    "check:direction-contracts": "node scripts/check-product-direction-contracts.mjs",
    "check:direction-rules": "node --test scripts/check-product-direction-rules.mjs",
    "seed:direction": "node scripts/seed-product-direction-fixtures.mjs --scenario=all --write",
    "check:direction-callables": "node --test scripts/check-product-direction-callables.mjs",
    "check:direction-emulators": "firebase emulators:exec --only auth,firestore,functions --project demo-gridworkz-direction \"npm run check:direction-rules && npm run seed:direction && npm run check:direction-callables && npm run check:routine-reward-callables && npm run check:weekly-planning-callables && npm run check:direction-browser\"",
    "check:direction-browser": "playwright test --config playwright.direction.config.js",
    "check:direction-fixtures": "node --test scripts/check-product-direction-fixtures.mjs",
    "check:routine-reward-helpers": "node scripts/check-routine-reward-helpers.mjs",
    "check:routine-entitlements": "node scripts/check-routine-entitlement-parity.mjs",
    "check:routine-reward-callables": "node --test scripts/check-routine-reward-callables.mjs",
    "check:routine-view-model": "node scripts/check-routine-view-model.mjs",
    "check:weekly-planning-helpers": "node scripts/check-weekly-planning-helpers.mjs && node scripts/check-weekly-plan-view-model.mjs && node scripts/check-weekly-authority-readers.mjs",
    "check:weekly-planning-callables": "node --test scripts/check-weekly-planning-callables.mjs"
  },
  "dependencies": {
    "firebase": "^10.8.0",
    "lucide-react": "^0.323.0",
    "nanoid": "^5.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "firebase-tools": "^15.12.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.8"
  },
  "keywords": [
    "education",
    "homeschool",
    "lms",
    "react",
    "firebase",
    "tailwindcss"
  ],
  "author": "GridWorkz Team",
  "license": "MIT"
}
