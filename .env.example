# Frontend configuration for your own development Firebase project.
# These VITE_ values are embedded in the client bundle; never place server secrets here.
VITE_FIREBASE_API_KEY=replace-with-development-project-value
VITE_FIREBASE_AUTH_DOMAIN=replace-with-development-project-value
VITE_FIREBASE_PROJECT_ID=replace-with-development-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-development-project-value
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-development-project-value
VITE_FIREBASE_APP_ID=replace-with-development-project-value
VITE_FIREBASE_MEASUREMENT_ID=replace-with-development-project-value
# Optional: enable only when following the isolated emulator test setup.
VITE_USE_FIREBASE_EMULATORS=false
